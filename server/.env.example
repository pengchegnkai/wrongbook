JWT_SECRET=CHANGE_ME_TO_RANDOM_STRING
API_TOKEN=
HOST=0.0.0.0
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=cuoti
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=cuoti
LLAMA_BASE_URL=http://127.0.0.1:8080
# 本地模型（pkg 版 llama-server：pkg install llama-cpp llama-cpp-backend-vulkan）
# 换模型三步：换 gguf 文件 → 改 MODEL_PATH/MODEL_NAME → bash termux/llama-server.sh restart
MODEL_PATH=~/storage/downloads/MiniCPM5-1B-Q8_0.gguf
MODEL_NAME=minicpm5-1b-q8
# 提示词基础风格：general（通用，默认）/ step_by_step / concise / exam_oriented
PROMPT_TEMPLATE=general
# CORS 白名单（逗号分隔，支持 * 通配）
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*,http://10.*.*.*:*,http://172.16.*.*:*
# 云端 AI 预留：不启用，不填 key
CLOUD_AI_ENABLED=false
CLOUD_AI_BASE_URL=
CLOUD_AI_API_KEY=YOUR_API_KEY_HERE
